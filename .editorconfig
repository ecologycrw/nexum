# Basic text rules for every editor. C++ formatting lives in .clang-format.
# This file is a protected "trava" (see docs/WORKFLOW.md).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.ps1]
charset = utf-8-bom
