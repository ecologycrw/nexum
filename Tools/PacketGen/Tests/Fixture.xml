<?xml version="1.0" encoding="utf-8"?>
<!-- Packets written for the tests of packetgen, in the format of the OpenMU packet definitions. They are not packets
     of any game: each one exercises a kind of field, so the tests can fix every byte. -->
<PacketDefinitions xmlns="http://www.munique.net/OpenMU/PacketDefinitions">
  <Structures>
    <Structure>
      <Name>Point</Name>
      <Description>Two coordinates.</Description>
      <Length>3</Length>
      <Fields>
        <Field>
          <Index>0</Index>
          <Type>Byte</Type>
          <Name>X</Name>
        </Field>
        <Field>
          <Index>1</Index>
          <Type>Byte</Type>
          <Name>Y</Name>
        </Field>
      </Fields>
    </Structure>
  </Structures>
  <Packets>
    <Packet>
      <HeaderType>C1HeaderWithSubCode</HeaderType>
      <Code>A1</Code>
      <SubCode>02</SubCode>
      <Name>EveryField</Name>
      <Direction>ClientToServer</Direction>
      <SentWhen>Never: it exists for the tests.</SentWhen>
      <CausedReaction>None.</CausedReaction>
      <Fields>
        <Field>
          <Index>4</Index>
          <LeftShifted>4</LeftShifted>
          <Type>Byte</Type>
          <Name>High</Name>
          <Length>4</Length>
        </Field>
        <Field>
          <Index>4</Index>
          <Type>Byte</Type>
          <Name>Low</Name>
          <Length>4</Length>
        </Field>
        <Field>
          <Index>5</Index>
          <Type>ShortLittleEndian</Type>
          <Name>Little</Name>
        </Field>
        <Field>
          <Index>7</Index>
          <Type>ShortBigEndian</Type>
          <Name>Big</Name>
        </Field>
        <Field>
          <Index>9</Index>
          <Type>IntegerBigEndian</Type>
          <Name>BigWord</Name>
        </Field>
        <Field>
          <Index>13</Index>
          <LeftShifted>3</LeftShifted>
          <Type>Boolean</Type>
          <Name>Flag</Name>
        </Field>
        <Field>
          <Index>14</Index>
          <Type>String</Type>
          <Name>Label</Name>
          <Length>5</Length>
        </Field>
        <Field>
          <Index>19</Index>
          <Type>Enum</Type>
          <TypeName>Color</TypeName>
          <Name>Paint</Name>
          <DefaultValue>Color.Green</DefaultValue>
        </Field>
        <Field>
          <Index>20</Index>
          <Type>LongLittleEndian</Type>
          <Name>LittleLong</Name>
        </Field>
        <Field>
          <Index>28</Index>
          <Type>Binary</Type>
          <Name>Rest</Name>
        </Field>
      </Fields>
      <Enums>
        <Enum>
          <Name>Color</Name>
          <Description>A few colors.</Description>
          <Values>
            <EnumValue>
              <Name>Red</Name>
              <Description>The first.</Description>
              <Value>1</Value>
            </EnumValue>
            <EnumValue>
              <Name>Green</Name>
              <Description>The second.</Description>
              <Value>2</Value>
            </EnumValue>
          </Values>
        </Enum>
      </Enums>
    </Packet>
    <Packet>
      <HeaderType>C2Header</HeaderType>
      <Code>B0</Code>
      <Name>PointList</Name>
      <Direction>ServerToClient</Direction>
      <SentWhen>Never: it exists for the tests.</SentWhen>
      <CausedReaction>None.</CausedReaction>
      <Fields>
        <Field>
          <Index>4</Index>
          <Type>Byte</Type>
          <Name>PointCount</Name>
        </Field>
        <Field>
          <Index>5</Index>
          <Type>Structure[]</Type>
          <TypeName>Point</TypeName>
          <Name>Points</Name>
          <ItemCountField>PointCount</ItemCountField>
        </Field>
      </Fields>
    </Packet>
    <Packet>
      <HeaderType>C3Header</HeaderType>
      <Code>0C</Code>
      <Name>Fixed</Name>
      <Length>6</Length>
      <Direction>ClientToServer</Direction>
      <SentWhen>Never: it exists for the tests.</SentWhen>
      <CausedReaction>None.</CausedReaction>
      <Fields>
        <Field>
          <Index>3</Index>
          <Type>Byte</Type>
          <Name>Value</Name>
          <DefaultValue>0x28</DefaultValue>
        </Field>
      </Fields>
    </Packet>
  </Packets>
</PacketDefinitions>
