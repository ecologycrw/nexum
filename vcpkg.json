{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "nexum",
  "version-string": "0.0.0",
  "description": "Clean-room C++20 engine for a game client compatible with the unmodified OpenMU server.",
  "license": "MIT",
  "dependencies": [
    {
      "name": "sdl3",
      "default-features": false,
      "features": [
        "vulkan",
        { "name": "x11", "platform": "linux" },
        { "name": "wayland", "platform": "linux" }
      ]
    },
    "asio",
    "tl-expected",
    "doctest"
  ],
  "features": {
    "profiler": {
      "description": "The Tracy profiler, for the development build only; turned on by the CMake option NEXUM_PROFILER",
      "dependencies": [
        {
          "name": "tracy",
          "default-features": false,
          "features": ["on-demand"]
        }
      ]
    }
  }
}
