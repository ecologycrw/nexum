{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(py scripts/dev.py:*)",
      "Bash(python3 scripts/dev.py:*)",
      "Bash(py scripts/checks/run.py:*)",
      "Bash(python3 scripts/checks/run.py:*)",
      "PowerShell(py scripts/dev.py:*)",
      "PowerShell(python3 scripts/dev.py:*)",
      "PowerShell(py scripts/checks/run.py:*)",
      "PowerShell(python3 scripts/checks/run.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git remote)",
      "Bash(git branch --show-current)",
      "Bash(git switch -c fatia/:*)",
      "Bash(git switch -c consolidacao/:*)",
      "Bash(git switch main)",
      "Bash(git pull --ff-only)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push -u origin fatia/:*)",
      "Bash(git push origin fatia/:*)",
      "Bash(git push -u origin consolidacao/:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(git remote)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git switch -c fatia/:*)",
      "PowerShell(git switch -c consolidacao/:*)",
      "PowerShell(git switch main)",
      "PowerShell(git pull --ff-only)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push)",
      "PowerShell(git push -u origin fatia/:*)",
      "PowerShell(git push origin fatia/:*)",
      "PowerShell(git push -u origin consolidacao/:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "PowerShell(gh pr create:*)",
      "PowerShell(gh pr view:*)",
      "PowerShell(gh pr checks:*)",
      "PowerShell(gh pr list:*)",
      "PowerShell(gh run list:*)",
      "PowerShell(gh run view:*)",
      "mcp_ccd_pr_set_monitor"
    ],
    "ask": [
      "Bash(git merge:*)",
      "PowerShell(git merge:*)",
      "Edit(.claude/**)",
      "Edit(.githooks/**)",
      "Edit(.github/**)",
      "Edit(cmake/**)",
      "Edit(CMakePresets.json)",
      "Edit(vcpkg.json)",
      "Edit(vcpkg-configuration.json)",
      "Edit(.clang-format)",
      "Edit(.clang-tidy)",
      "Edit(.editorconfig)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(scripts/dev.py)",
      "Edit(scripts/checks/**)",
      "Edit(tests/architecture/**)",
      "Edit(tests/hooks/**)",
      "Edit(tests/visual/approved/**)",
      "Edit(docs/referencia/**)",
      "Edit(docs/VISION.md)",
      "Edit(docs/ROADMAP.md)",
      "Edit(docs/VISUAL.md)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git config:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git branch -D:*)",
      "Bash(gh auth:*)",
      "Bash(gh api:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo delete:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git push origin main:*)",
      "PowerShell(git push -u origin main:*)",
      "PowerShell(git commit --no-verify:*)",
      "PowerShell(git commit -n:*)",
      "PowerShell(git config:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git rebase:*)",
      "PowerShell(git branch -D:*)",
      "PowerShell(gh auth:*)",
      "PowerShell(gh api:*)",
      "PowerShell(gh pr merge:*)",
      "PowerShell(gh repo edit:*)",
      "PowerShell(gh repo delete:*)",
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.ps1\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.ps1\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-central.ps1\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.ps1\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
