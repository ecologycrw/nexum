#!/bin/sh
# Nexum pre-commit hook: blocks the commit when something is wrong.
# Never skip it with --no-verify (docs/WORKFLOW.md). The CI runs the same checks again.
set -eu

staged=$(git diff --cached --name-only)
if [ -z "$staged" ]; then
  exit 0
fi

echo "[pre-commit] secret scan"
sh .githooks/scan-secrets.sh

# Git exports these variables to hooks; the tests must not inherit them.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX

if command -v py >/dev/null 2>&1; then
  python="py -3"
else
  python="python3"
fi

# Only Markdown files staged? Then the documentation checks are enough.
if printf '%s\n' "$staged" | grep -qvE '\.md$'; then
  echo "[pre-commit] format, build, tests and checks"
  $python scripts/dev.py quick
else
  echo "[pre-commit] documentation checks (only Markdown files changed)"
  $python scripts/checks/run.py docs terms
fi
